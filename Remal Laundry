            currentService = service;
            ['laundry', 'dry', 'pressing'].forEach(s => {
                document.getElementById(`tab-service-${s}`).className = s === service ? "flex-1 py-2.5 rounded-xl bg-[#DCA773] text-stone-950 shadow-sm font-bold" : "flex-1 py-2.5 rounded-xl bg-[#12100e] text-stone-400 border border-[#382d24]";
            });
            renderItems();
        }

        function renderItems() {
            const container = document.getElementById('itemsContainer');
            container.innerHTML = '';
            const serviceData = database[currentService] || {};
            for (const [catName, items] of Object.entries(serviceData)) {
                const catHeader = document.createElement('div');
                catHeader.className = 'bg-[#12100e] text-[#DCA773] px-3 py-1.5 rounded-xl font-bold text-xs uppercase tracking-wider mb-2 mt-2 border border-[#382d24]'; 
                catHeader.innerText = catName;
                container.appendChild(catHeader);

                items.forEach(item => {
                    const key = `${currentService}_${item.name}`;
                    const qty = cart[key] ? cart[key].qty : 0;
                    const priceDisplay = currentCountType === 'hotel' ? '0.00 AED' : `${item.price.toFixed(2)} AED`;

                    const row = document.createElement('div');
                    row.className = 'flex justify-between items-center py-2 border-b border-[#382d24] text-xs';
                    row.innerHTML = `
                        <div>
                            <p class="font-bold text-stone-200">${item.name}</p>
                            <p class="text-[10px] ${currentCountType === 'hotel' ? 'text-emerald-400 font-bold' : 'text-[#DCA773] font-semibold'}">${priceDisplay}</p>
                        </div>
                        <div class="flex items-center space-x-2 bg-[#12100e] p-1 rounded-xl border border-[#382d24]">
                            <button onclick="updateQty('${key}', '${item.name}', ${item.price}, -1)" class="w-6 h-6 bg-[#191512] text-stone-200 rounded font-bold shadow-sm">-</button>
                            <span class="font-bold px-1 text-stone-100">${qty}</span>
                            <button onclick="updateQty('${key}', '${item.name}', ${item.price}, 1)" class="w-6 h-6 bg-[#DCA773] text-stone-950 rounded font-bold shadow-sm">+</button>
                        </div>
                    `;
                    container.appendChild(row);
                });
            }
        }

        function updateQty(key, name, price, delta) {
            if (!cart[key]) cart[key] = { qty: 0, price: price, name: name, service: currentService };
            cart[key].qty += delta;
            if (cart[key].qty <= 0) delete cart[key];
            renderItems(); calculateGlobalTotals();
        }

        function calculateGlobalTotals() {
            let totalClothes = 0, subtotal = 0;
            Object.values(cart).forEach(item => { totalClothes += item.qty; if (currentCountType === 'guest') subtotal += item.price * item.qty; });
            const vat = subtotal * 0.05, grandTotal = subtotal + vat;
            document.getElementById('currentBordereauCount').innerText = `${totalClothes} pieces`;
            document.getElementById('subTotal').innerText = `${subtotal.toFixed(2)} AED`;
            document.getElementById('vatAmount').innerText = `${vat.toFixed(2)} AED`;
            document.getElementById('grandTotal').innerText = `${grandTotal.toFixed(2)} AED`;
        }

        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                currentImageData = e.target.result;
                const previewEl = document.getElementById('imagePreview');
                previewEl.src = currentImageData;
                previewEl.classList.remove('hidden');
            }
            reader.readAsDataURL(file);
        }

        async function sauvegarderBordereauSupabase() {
            const roomNum = document.getElementById('roomNumber').value.trim();
            if (!roomNum) { alert('Please enter a room number.'); return; }
            if (Object.keys(cart).length === 0 && !currentImageData) { alert('Please select at least one garment.'); return; }

            let totalClothes = 0; Object.values(cart).forEach(item => totalClothes += item.qty);
            let subtotal = 0; if (currentCountType === 'guest') Object.values(cart).forEach(item => subtotal += item.price * item.qty);
            const vat = subtotal * 0.05, grandTotal = subtotal + vat;
            const pmsData = pmsDatabase[roomNum] || { guestName: 'Unknown Guest', roomTyp: 'DLXR', agency: 'Direct', quotaText: 'Chargeable' };

            const newRecord = {
                room: roomNum,
                count_type: currentCountType,
                options: { service_style: document.querySelector('input[name="foldingOption"]:checked')?.value || 'F — Folding' },
                items: cart,
                total_clothes: totalClothes,
                subtotal: subtotal,
                vat: vat,
                total: grandTotal,
                photo: currentImageData,
                guest_name: pmsData.guestName,
                room_typ: pmsData.roomTyp,
                agency: pmsData.agency,
                quota: pmsData.quotaText,
                status: 'Collected',
                created_at: new Date().toISOString()
            };

            try {
                const { error } = await supabaseClient.from('laundry_records').insert([newRecord]);
                if (error) throw error;
                alert(`Record for Room ${roomNum} saved successfully!`);
                reinitialiserFormulaire();
                switchMainSection('liveRecord');
            } catch (err) {
                console.error("Error saving record:", err);
                alert("Error saving record to cloud.");
            }
        }

        function reinitialiserFormulaire() {
            document.getElementById('roomNumber').value = '';
            document.getElementById('roomPmsInfoBox').classList.add('hidden');
            cart = {}; currentImageData = null;
            document.getElementById('imagePreview').classList.add('hidden');
            renderItems(); calculateGlobalTotals();
        }

        async function handlePDFUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const counterContainer = document.getElementById('massRecordCounter');
            counterContainer.innerHTML = "Reading PDF file...";

            try {
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                let extractedText = "";

                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const textContent = await page.getTextContent();
                    textContent.items.forEach(item => { extractedText += item.str + "\t"; });
                    extractedText += "\n\n";
                }
                document.getElementById('pmsPasteArea').value = extractedText;
                processTextData(extractedText);
            } catch (error) {
                console.error("PDF Read Error:", error);
                alert("Error reading PDF.");
            }
        }

        async function processTextData(rawData) {
            const container = document.getElementById('massPreviewContainer');
            const counterContainer = document.getElementById('massRecordCounter');
            const resultsCard = document.getElementById('massResultsCard');

            if (!rawData.trim()) { alert("No data."); return; }
            let parsedData = [];
            let rows = rawData.split('\n');

            rows.forEach(line => {
                let cols = line.split('\t').map(c => c.trim()).filter(Boolean);
                if (cols.length >= 2 && /^\d{3,4}$/.test(cols[0])) {
                    parsedData.push({
                        room: cols[0],
                        guestName: cols[1] || 'Guest',
                        roomTyp: cols[2] || 'DLXR',
                        agency: cols[6] || 'Direct',
                        quotaText: 'Chargeable',
                        is_chargeable: true
                    });
                }
            });

            if (parsedData.length > 0) {
                resultsCard.classList.remove('hidden');
                let html = '';
                let supabaseRows = [];
                pmsDatabase = {};

                parsedData.forEach(item => {
                    pmsDatabase[item.room] = item;
                    supabaseRows.push({
                        room: item.room,
                        guest_name: item.guestName,
                        room_typ: item.roomTyp,
                        agency: item.agency,
                        quota_text: item.quotaText,
                        is_chargeable: item.is_chargeable
                    });
                    html += `<tr><td class="p-3"><strong>${item.room}</strong></td><td class="p-3">${item.guestName}</td><td class="p-3">${item.roomTyp}</td><td class="p-3">${item.agency}</td><td class="p-3"><span class="badge-chargeable">Chargeable</span></td></tr>`;
                });
                container.innerHTML = html;

                if (supabaseClient) {
                    await supabaseClient.from('pms_guests').delete().neq('room', '000');
                    await supabaseClient.from('pms_guests').insert(supabaseRows);
                }
                counterContainer.innerHTML = `${parsedData.length} records synced successfully!`;
            }
        }

        async function chargerLiveOrdersSupabase() {
            const container = document.getElementById('liveOrdersList');
            if (!supabaseClient) return;
            try {
                const { data } = await supabaseClient.from('laundry_records').select('*');
                cachedSlips = data || [];
                const todayStr = new Date().toISOString().split('T')[0];
                const activeToday = cachedSlips.filter(e => e.created_at && e.created_at.startsWith(todayStr));

                document.getElementById('activeRoomsCountBadge').innerText = activeToday.length;
                if (activeToday.length === 0) { container.innerHTML = `<p class="text-xs text-stone-500 text-center py-6">No active records for today.</p>`; return; }

                container.innerHTML = '';
                activeToday.forEach(entry => {
                    const div = document.createElement('div');
                    div.className = 'remal-card p-4 rounded-2xl space-y-3 cursor-pointer hover:border-[#DCA773] transition';
                    div.onclick = () => ouvrirModalDetails(entry.id);
                    div.innerHTML = `<div class="flex justify-between items-start"><div><span class="font-serif-luxury font-bold text-[#DCA773] text-lg">Room ${entry.room}</span><p class="text-[10px] text-stone-400 mt-1">${entry.guest_name || 'Guest'}</p></div><div class="text-right"><p class="text-[11px] text-stone-300 font-semibold">${entry.total_clothes} pcs</p><p class="font-serif-luxury font-bold text-[#DCA773] text-sm">${entry.total.toFixed(2)} AED</p></div></div>`;
                    container.appendChild(div);
                });
            } catch (err) { console.error(err); }
        }

        async function afficherListeBordereauxSupabase() {
            const container = document.getElementById('laundryList');
            if (!supabaseClient) return;
            const { data } = await supabaseClient.from('laundry_records').select('*');
            cachedSlips = data || [];
            container.innerHTML = '';
            cachedSlips.forEach(entry => {
                const div = document.createElement('div');
                div.className = 'p-3.5 bg-[#12100e] rounded-2xl border border-[#382d24] text-xs flex justify-between items-center cursor-pointer hover:border-[#DCA773] transition';
                div.onclick = () => ouvrirModalDetails(entry.id);
                div.innerHTML = `<div><span class="font-serif-luxury font-bold text-[#DCA773] text-sm">Room ${entry.room}</span><div class="text-[10px] text-stone-400">${entry.guest_name}</div></div><div class="text-right font-bold text-stone-200"><span class="text-[#DCA773]">${entry.total.toFixed(2)} AED</span></div>`;
                container.appendChild(div);
            });
        }

        async function renderManagementDashboardSupabase() {
            if (!supabaseClient) return;
            const { data } = await supabaseClient.from('laundry_records').select('*');
            cachedSlips = data || [];
            let totalRev = 0, totalPcs = 0;
            cachedSlips.forEach(s => { totalRev += s.total || 0; totalPcs += s.total_clothes || 0; });
            document.getElementById('kpiRevenue').innerText = `${totalRev.toFixed(2)} AED`;
            document.getElementById('kpiOrders').innerText = cachedSlips.length;
            document.getElementById('kpiGarments').innerText = `${totalPcs} pcs`;
        }

        function calculateSpaTotal() {
            let grandTotal = 0;
            document.querySelectorAll('#spa-laundry-section tbody tr:not(.bg-\\[\\#191512\\])').forEach(row => {
                const input = row.querySelector('.spa-qty-input');
                if(!input) return;
                const qty = parseInt(input.value) || 0;
                const rate = parseFloat(input.getAttribute('data-rate'));
                row.querySelector('.spa-row-amount').innerText = (qty * rate).toFixed(2);
                grandTotal += qty * rate;
            });
            document.getElementById('spa-grand-total').innerText = grandTotal.toFixed(2) + " AED";
        }

        async function validateAndSaveSpaReceiptSupabase() {
            const serialNo = document.getElementById('spa-serial-no').innerText;
            const total = parseFloat(document.getElementById('spa-grand-total').innerText) || 0;
            const givenBy = document.getElementById('spa-given-by').value.trim();
            if (!givenBy) { alert("Please enter Given By name."); return false; }

            let spaItems = {}, totalClothes = 0;
            document.querySelectorAll('#spa-laundry-section tbody tr:not(.bg-\\[\\#191512\\])').forEach(row => {
                const input = row.querySelector('.spa-qty-input');
                const qty = parseInt(input.value) || 0;
                if(qty > 0) {
                    const name = row.querySelector('td').innerText;
                    spaItems[name] = { name, qty, price: parseFloat(input.getAttribute('data-rate')) };
                    totalClothes += qty;
                }
            });

            const record = {
                is_spa: true, spa_serial: serialNo, room: `SPA #${serialNo}`, guest_name: givenBy,
                room_typ: 'SPA', agency: 'V Element SPA', count_type: 'guest', items: spaItems,
                total_clothes: totalClothes, subtotal: total, vat: 0, total: total, status: 'Collected', created_at: new Date().toISOString()
            };

            await supabaseClient.from('laundry_records').insert([record]);
            alert("SPA Receipt saved successfully!");
            return true;
        }

        async function exportSpaToPDF() {
            if (await validateAndSaveSpaReceiptSupabase()) {
                html2pdf().from(document.getElementById('spa-laundry-section')).save();
            }
        }

        async function ouvrirModalDetails(id) {
            selectedIdForModal = id;
            const { data } = await supabaseClient.from('laundry_records').select('*').eq('id', id).single();
            if (!data) return;
            document.getElementById('modalRoomNumDisplay').innerText = data.room;
            document.getElementById('modalClothesCount').innerText = `${data.total_clothes} pieces`;
            document.getElementById('modalTotal').innerText = `${data.total.toFixed(2)} AED`;
            
            const tbody = document.getElementById('modalTableBody'); tbody.innerHTML = '';
            Object.values(data.items || {}).forEach(item => {
                tbody.innerHTML += `<tr><td class="p-2.5">${item.name}</td><td class="text-center p-2.5">${item.qty}</td><td class="text-right p-2.5">${(item.qty * item.price).toFixed(2)}</td></tr>`;
            });
            document.getElementById('detailModal').classList.remove('hidden');
        }

        function genererPDF() { html2pdf().from(document.getElementById('pdfExportArea')).save(); }
        function fermerModal() { document.getElementById('detailModal').classList.add('hidden'); }
        async function supprimerBordereauSupabase() {
            if (confirm("Delete record?")) {
                await supabaseClient.from('laundry_records').delete().eq('id', selectedIdForModal);
                fermerModal();
                chargerLiveOrdersSupabase();
            }
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" id="htmlRoot" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remal Hotel & Villas - Front Desk & Laundry Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <!-- Supabase Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
    <style>
        :root {
            --bg-dark: #12100e;
            --bg-card: #191512;
            --bg-card-hover: #221d18;
            --text-gold: #DCA773;
            --text-light: #e0e0e0;
            --border-gold: #382d24;
            --font-family: 'Montserrat', 'Plus Jakarta Sans', sans-serif;
            --color-green-bg: rgba(40, 167, 69, 0.15);
            --color-green-text: #5cb85c;
        }
        body { font-family: var(--font-family); background-color: var(--bg-dark); color: #f5f5f5; }
        .font-serif-luxury { font-family: 'Playfair Display', serif; }
        .scrollbar-none::-webkit-scrollbar { display: none; }
        .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
        .bg-remal-sand { background-color: #DCA773; }
        .text-remal-sand { color: #DCA773; }
        .remal-card { background: var(--bg-card); border: 1px solid var(--border-gold); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); }
        .remal-input { background: #12100e; border: 1px solid var(--border-gold); color: #f5f5f5; }
        .remal-input:focus { border-color: #DCA773; outline: none; }
        .laundry-row { background-color: var(--color-green-bg) !important; }
        .badge-green { color: var(--color-green-text); font-weight: bold; background-color: rgba(40, 167, 69, 0.2); padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(92, 184, 92, 0.3); display: inline-block; }
        .badge-chargeable { color: #f87171; font-weight: bold; background-color: rgba(248, 113, 113, 0.15); padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(248, 113, 113, 0.3); display: inline-block; }
        input[type="date"]::-webkit-calendar-picker-indicator,
        input[type="time"]::-webkit-calendar-picker-indicator {
            filter: invert(0.8) sepia(1) saturate(3) hue-rotate(340deg);
            cursor: pointer;
        }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- ÉCRAN DE CONNEXION ÉPURÉ ET DESIGN -->
    <div id="loginScreen" class="fixed inset-0 bg-[#12100e] z-[200] flex items-center justify-center p-4">
        <div class="remal-card w-full max-w-md p-8 rounded-3xl space-y-6 text-center shadow-2xl relative">
            <div>
                <h1 class="text-xl font-serif-luxury text-[#DCA773] font-bold tracking-[0.25em]">R E M A L</h1>
                <p class="text-[10px] text-stone-400 uppercase tracking-widest mt-1">Al Ruwais City, Abu Dhabi – UAE</p>
                <p class="text-xs text-stone-300 font-semibold mt-4">Select Your Operational Department</p>
            </div>

            <!-- SÉLECTEUR DE RÔLE (CARTES CÔTE À CÔTE) -->
            <div class="grid grid-cols-2 gap-3">
                <button onclick="selectLoginRole('reception')" id="roleCardReception" class="p-4 rounded-2xl border border-[#382d24] bg-[#12100e] hover:border-[#DCA773] transition text-center cursor-pointer group">
                    <div class="text-xl mb-1 text-[#DCA773]"><i class="fas fa-desktop"></i></div>
                    <div class="text-xs font-bold text-stone-200 group-hover:text-[#DCA773]">Front Desk</div>
                    <div class="text-[9px] text-stone-400 mt-0.5">Reception & PMS</div>
                </button>
                <button onclick="selectLoginRole('laundry')" id="roleCardLaundry" class="p-4 rounded-2xl border border-[#382d24] bg-[#12100e] hover:border-[#DCA773] transition text-center cursor-pointer group">
                    <div class="text-xl mb-1 text-[#DCA773]"><i class="fas fa-tshirt"></i></div>
                    <div class="text-xs font-bold text-stone-200 group-hover:text-[#DCA773]">Laundry Plant</div>
                    <div class="text-[9px] text-stone-400 mt-0.5">Plant & Operations</div>
                </button>
            </div>

            <!-- SECTION MOT DE PASSE -->
            <div id="passwordSection" class="hidden space-y-3 pt-2">
                <div class="bg-[#12100e] p-4 rounded-2xl border border-[#382d24] text-left space-y-2">
                    <label id="selectedRoleLabel" class="block text-xs font-bold text-[#DCA773] uppercase">Enter Password</label>
                    <div class="flex gap-2">
                        <input type="password" id="rolePasswordInput" placeholder="Enter password..." class="w-full remal-input rounded-xl px-3 py-2.5 text-xs font-semibold">
                        <button onclick="submitLogin()" class="bg-[#DCA773] hover:bg-[#c89360] text-stone-950 font-bold px-5 py-2.5 rounded-xl text-xs transition">Login</button>
                    </div>
                </div>
            </div>

            <p id="loginErrorMsg" class="text-rose-400 text-xs font-bold hidden">⚠️ Invalid password. Please try again.</p>
        </div>
    </div>

    <!-- HEADER -->
    <header class="bg-[#12100e] sticky top-0 z-50 border-b border-[#382d24] shadow-md">
        <div class="max-w-3xl mx-auto px-5 py-3.5 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div>
                    <h1 class="text-base font-serif-luxury text-[#DCA773] font-bold tracking-[0.25em]">R E M A L</h1>
                    <p class="text-[9px] text-stone-400 uppercase tracking-widest mt-0.5" id="headerRoleIndicator">Connected Role: ---</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <button onclick="logout()" class="text-xs text-rose-400 font-bold bg-rose-950/40 border border-rose-800 px-3 py-1.5 rounded-xl hover:bg-rose-900/40 transition">Logout</button>
                <select id="langSelect" onchange="setLang(this.value)" class="bg-[#191512] text-stone-300 text-xs border border-[#382d24] rounded-xl px-3 py-1.5 outline-none font-semibold cursor-pointer">
                    <option value="en">English</option>
                    <option value="ar">العربية</option>
                    <option value="hi">हिन्दी</option>
                </select>
            </div>
        </div>
    </header>

    <div class="max-w-2xl mx-auto px-4 py-4 space-y-4">

        <!-- NAVIGATION -->
        <div id="receptionNav" class="hidden flex bg-[#191512] p-1.5 rounded-2xl border border-[#382d24] text-[11px] font-bold gap-1 text-stone-400">
            <button onclick="switchMainSection('massEntry')" id="navBtnMassEntry" class="flex-1 py-2.5 rounded-xl bg-[#DCA773] text-stone-950 shadow-md transition text-center">Reception Mass PDF & Cloud Sync</button>
        </div>

        <div id="laundryNav" class="hidden flex bg-[#191512] p-1.5 rounded-2xl border border-[#382d24] text-[11px] font-bold gap-1 text-stone-400">
            <button onclick="switchMainSection('liveRecord')" id="navBtnLiveRecord" class="flex-1 py-2.5 rounded-xl bg-[#DCA773] text-stone-950 shadow-md transition text-center">Active Rooms</button>
            <button onclick="switchMainSection('spa')" id="navBtnSpa" class="flex-1 py-2.5 rounded-xl transition text-center hover:text-stone-200">SPA</button>
            <button onclick="switchMainSection('pdfList')" id="navBtnPdfList" class="flex-1 py-2.5 rounded-xl transition text-center hover:text-stone-200">Archives & Search</button>
            <button onclick="switchMainSection('dashboard')" id="navBtnDashboard" class="flex-1 py-2.5 rounded-xl transition text-center hover:text-stone-200">Chart</button>
        </div>

        <!-- BOUTONS D'ACTION RAPIDE -->
        <div id="quickActionButtons" class="grid grid-cols-2 gap-3 hidden">
            <button onclick="switchMainSection('newRecord')" class="bg-[#DCA773] hover:bg-[#c89360] text-stone-950 font-bold py-3.5 px-4 rounded-2xl text-xs flex items-center justify-center gap-2 shadow-lg transition">
                <span class="text-base font-bold">+</span> <span id="txtBtnNewRecord">New Record</span>
            </button>
            <button onclick="switchMainSection('pdfList')" class="bg-[#191512] hover:bg-[#221d18] text-stone-200 font-bold py-3.5 px-4 rounded-2xl text-xs border border-[#382d24] flex items-center justify-center gap-2 transition">
                <span>📄</span> <span id="txtBtnPdfListNav">PDF List</span>
            </button>
        </div>

        <!-- SECTION NEW RECORD -->
        <div id="sectionNewRecord" class="hidden space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-5 relative">
                <div class="flex justify-between items-center border-b border-[#382d24] pb-3">
                    <h2 class="text-lg font-serif-luxury font-bold text-[#DCA773]" id="lblFormTitle">New Record</h2>
                    <button onclick="switchMainSection('liveRecord')" class="text-stone-400 hover:text-stone-200 font-bold text-xl px-2">✕</button>
                </div>

                <input type="hidden" id="editingRecordId" value="">

                <div>
                    <label class="block text-xs font-bold text-stone-400 mb-1 tracking-wide" id="lblRoomNum">Room Number</label>
                    <input type="number" id="roomNumber" oninput="onRoomNumberInput()" placeholder="e.g., 103, 205, 348..." class="w-full remal-input rounded-xl p-3 text-sm font-bold">
                    <p class="text-[10px] text-stone-400 mt-1" id="lblValidRanges">Valid: 103-144 · 201-246 · 301-348 · 401-448 · 501-520</p>
                    
                    <div id="roomPmsInfoBox" class="hidden mt-2 p-3.5 bg-[#221d18] border border-[#382d24] rounded-2xl text-xs space-y-1.5 shadow-sm">
                        <div class="flex justify-between font-bold text-stone-200"><span>Guest Name:</span> <span id="pmsInfoGuest" class="text-stone-300">---</span></div>
                        <div class="flex justify-between font-bold text-stone-200"><span>Room Type (Typ):</span> <span id="pmsInfoTyp" class="text-stone-300">---</span></div>
                        <div class="flex justify-between font-bold text-amber-200 border-t border-[#382d24] pt-1"><span>PMS Quota / Status:</span> <span id="pmsInfoQuota" class="text-emerald-400">---</span></div>
                        <div class="flex justify-between font-bold text-amber-200"><span>Agency:</span> <span id="pmsInfoAgency" class="text-stone-300">---</span></div>
                    </div>

                    <p id="roomErrorMsg" class="hidden text-rose-400 text-xs font-bold mt-1.5 flex items-center gap-1">
                        ⚠️ <span id="lblRoomError">Invalid room number! Allowed ranges: 103-144, 201-246, 301-348, 401-448, 501-520, 601-608.</span>
                    </p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-stone-400 mb-1">Account Type</label>
                    <div class="flex bg-[#12100e] p-1.5 rounded-2xl border border-[#382d24] text-xs font-bold gap-2">
                        <button onclick="selectCountType('hotel')" id="btn-count-hotel" class="flex-1 py-2.5 rounded-xl bg-[#DCA773] text-stone-950 shadow-md">Hotel Count (Free)</button>
                        <button onclick="selectCountType('guest')" id="btn-count-guest" class="flex-1 py-2.5 rounded-xl text-stone-400">Guest Count</button>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-stone-400 mb-1">Service Type</label>
                    <div class="flex gap-2 text-xs font-bold">
                        <button onclick="switchService('laundry')" id="tab-service-laundry" class="flex-1 py-2.5 rounded-xl bg-[#DCA773] text-stone-950 shadow-sm">LAUNDRY</button>
                        <button onclick="switchService('dry')" id="tab-service-dry" class="flex-1 py-2.5 rounded-xl bg-[#12100e] text-stone-400 border border-[#382d24]">DRY CLEANING</button>
                        <button onclick="switchService('pressing')" id="tab-service-pressing" class="flex-1 py-2.5 rounded-xl bg-[#12100e] text-stone-400 border border-[#382d24]">PRESSING</button>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-stone-400 mb-1">Packaging</label>
                    <div class="grid grid-cols-3 gap-2 p-2 bg-[#12100e] rounded-2xl border border-[#382d24] text-xs font-bold text-center text-stone-300">
                        <label class="flex flex-col items-center justify-center p-2.5 bg-[#191512] rounded-xl border border-[#382d24] cursor-pointer hover:border-[#DCA773]">
                            <input type="radio" name="foldingOption" value="F — Folding" checked class="accent-[#DCA773] mb-1"> F — Folding
                        </label>
                        <label class="flex flex-col items-center justify-center p-2.5 bg-[#191512] rounded-xl border border-[#382d24] cursor-pointer hover:border-[#DCA773]">
                            <input type="radio" name="foldingOption" value="H/F — Hanger/Folding" class="accent-[#DCA773] mb-1"> H/F — Hanger
                        </label>
                        <label class="flex flex-col items-center justify-center p-2.5 bg-[#191512] rounded-xl border border-[#382d24] cursor-pointer hover:border-[#DCA773]">
                            <input type="radio" name="foldingOption" value="S — Single" class="accent-[#DCA773] mb-1"> S — Single
                        </label>
                    </div>
                </div>

                <div id="itemsContainer" class="space-y-3 max-h-80 overflow-y-auto pr-1 scrollbar-none"></div>

                <div class="bg-[#221d18] border border-[#382d24] text-[#DCA773] p-3.5 rounded-2xl flex justify-between items-center font-bold text-xs">
                    <span id="lblSelectedGarments">Total Garments:</span>
                    <span id="currentBordereauCount" class="bg-[#DCA773] text-stone-950 px-3 py-1 rounded-full text-xs">0 pieces</span>
                </div>

                <div class="bg-[#12100e] border border-[#382d24] p-4 rounded-2xl text-xs space-y-1.5 font-medium text-stone-300">
                    <div class="flex justify-between"><span id="lblSubTotal">Subtotal:</span><span id="subTotal">0.00 AED</span></div>
                    <div class="flex justify-between"><span id="lblVat">VAT (5%):</span><span id="vatAmount">0.00 AED</span></div>
                    <div class="flex justify-between font-bold text-sm text-stone-100 border-t border-[#382d24] pt-2 mt-1"><span id="lblGrandTotal">Grand Total:</span><span id="grandTotal" class="text-[#DCA773] font-serif-luxury text-base">0.00 AED</span></div>
                </div>

                <button onclick="document.getElementById('photoInput').click()" class="w-full bg-[#12100e] hover:bg-[#221d18] text-stone-300 font-bold p-3.5 rounded-xl text-xs border border-dashed border-[#382d24] transition flex items-center justify-center gap-2" id="btnPhotoProof">
                    <span>📷</span> Take Proof Photo (Camera)
                </button>
                <input type="file" id="photoInput" class="hidden" accept="image/*" capture="environment" onchange="previewImage(event)">
                <img id="imagePreview" class="hidden w-full max-h-48 object-cover rounded-2xl mt-2 border border-[#382d24]" alt="Preuve">

                <button onclick="sauvegarderBordereauSupabase()" id="btnSaveRecord" class="w-full bg-[#DCA773] hover:bg-[#c89360] text-stone-950 font-bold py-3.5 rounded-xl text-sm shadow-lg transition tracking-wider">💾 Save Record (Cloud)</button>
            </div>
        </div>

        <!-- SECTION MASS ENTRY -->
        <div id="sectionMassEntry" class="hidden space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-4">
                <div class="flex justify-between items-center border-b border-[#382d24] pb-3">
                    <h2 class="text-sm font-serif-luxury font-bold text-[#DCA773] uppercase tracking-wider">Front Desk — PMS Mass Entry & Cloud Sync</h2>
                    <span class="text-[10px] bg-amber-950 text-amber-200 font-bold px-2.5 py-1 rounded-full border border-amber-800">Supabase Connected</span>
                </div>
                
                <p class="text-xs text-stone-400">Upload your PMS multi-page PDF report directly or paste the text to update the database for the entire hotel instantly.</p>

                <div class="border-2 border-dashed border-[#382d24] p-4 text-center rounded-2xl bg-[#12100e]">
                    <input type="file" id="pdfFileReceiver" accept=".pdf" onchange="handlePDFUpload(event)" class="text-xs text-stone-400">
                </div>

                <div>
                    <textarea id="pmsPasteArea" placeholder="Or paste raw copied text from report here..." class="w-full h-28 bg-[#12100e] text-stone-200 p-3 rounded-xl font-mono text-xs outline-none border border-[#382d24] resize-vertical"></textarea>
                    <button onclick="processTextData(document.getElementById('pmsPasteArea').value)" class="mt-2 w-full bg-[#DCA773] hover:bg-[#c89360] text-stone-950 font-bold py-3 rounded-xl text-xs uppercase tracking-wider transition">Analyze & Sync to Supabase</button>
                </div>
                <div id="massRecordCounter" class="text-xs font-bold text-amber-400"></div>
            </div>

            <div id="massResultsCard" class="hidden remal-card p-6 rounded-3xl space-y-4">
                <h3 class="text-sm font-serif-luxury font-bold text-stone-200">Synced In-House Guest Laundry List</h3>
                <div class="max-h-[450px] overflow-y-auto border border-[#382d24] rounded-2xl">
                    <table class="w-full text-xs text-left border-collapse bg-[#12100e]">
                        <thead class="bg-[#191512] text-stone-300 sticky top-0 z-10">
                            <tr>
                                <th class="p-3">Room</th>
                                <th class="p-3">Guest Name</th>
                                <th class="p-3">Typ</th>
                                <th class="p-3">Arrival</th>
                                <th class="p-3">Departure</th>
                                <th class="p-3">Agency</th>
                                <th class="p-3">Laundry Status</th>
                            </tr>
                        </thead>
                        <tbody id="massPreviewContainer" class="divide-y divide-[#382d24]"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION ACTIVE ROOMS -->
        <div id="sectionLiveRecord" class="hidden space-y-4">
            <div class="flex justify-between items-center px-1">
                <span class="text-xs font-bold text-stone-400 uppercase tracking-wider" id="lblActiveRoomsHeader">Active Rooms</span>
                <span id="activeRoomsCountBadge" class="text-[10px] bg-[#191512] border border-[#382d24] text-[#DCA773] font-bold px-3 py-1 rounded-full">0</span>
            </div>

            <div id="liveOrdersList" class="space-y-3 pt-1"><p class="text-xs text-stone-500 text-center py-4">Loading active rooms from cloud...</p></div>
        </div>

        <!-- SECTION SPA -->
        <section id="spa-laundry-section" class="hidden remal-card p-6 rounded-3xl space-y-6 relative max-w-4xl mx-auto text-stone-200">
            <div class="border-b border-[#382d24] pb-6 flex justify-between items-center">
                <div class="space-y-2">
                    <h2 class="text-xl font-serif-luxury font-bold text-[#DCA773] tracking-wide">V Element SPA Laundry Daily Record Sheet</h2>
                    <div class="flex items-center gap-1.5 text-xs text-stone-400">
                        <span class="font-bold uppercase tracking-wider">Date :</span>
                        <span id="spa-current-date" class="font-semibold text-stone-200"></span>
                    </div>
                </div>
                <div class="text-right">
                    <div class="flex flex-col items-end">
                        <span class="block text-base font-black uppercase tracking-widest text-[#DCA773] leading-none">REMAL</span>
                        <span class="text-[9px] uppercase tracking-wider text-stone-400 font-bold mt-0.5">HOTEL & VILLAS</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-center gap-2 border-b border-[#382d24] py-1.5">
                    <span class="text-xs font-bold text-stone-400 uppercase min-w-[120px]">Given By (Spa) :</span>
                    <input type="text" id="spa-given-by" class="w-full text-stone-200 font-semibold focus:outline-none border-none p-0 bg-transparent" placeholder="Spa Employee Name">
                </div>
                <div class="flex items-center gap-2 border-b border-[#382d24] py-1.5 justify-end">
                    <span class="text-xs font-bold text-stone-400 uppercase">SERIAL NO:</span>
                    <span id="spa-serial-no" class="text-base font-black text-rose-400 ml-2">--</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse border border-[#382d24] rounded-2xl overflow-hidden bg-[#12100e]">
                    <thead>
                        <tr class="bg-[#191512] text-[#DCA773] text-xs uppercase tracking-wider text-center">
                            <th class="p-3 text-left">Item</th>
                            <th class="p-3">Quantity</th>
                            <th class="p-3">Rate (AED)</th>
                            <th class="p-3">Total Amount (AED)</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-medium divide-y divide-[#382d24]">
                        <tr class="hover:bg-[#221d18]">
                            <td class="p-3 font-semibold text-stone-300">BATH TOWEL</td>
                            <td class="p-3 text-center"><input type="number" class="spa-qty-input w-20 text-center remal-input rounded-lg p-1.5 font-bold" min="0" data-rate="2" oninput="calculateSpaTotal()"></td>
                            <td class="p-3 text-center text-stone-400">2.00</td>
                            <td class="p-3 text-center font-bold text-stone-200 spa-row-amount">0.00</td>
                        </tr>
                        <tr class="hover:bg-[#221d18]">
                            <td class="p-3 font-semibold text-stone-300">HAND TOWEL</td>
                            <td class="p-3 text-center"><input type="number" class="spa-qty-input w-20 text-center remal-input rounded-lg p-1.5 font-bold" min="0" data-rate="1" oninput="calculateSpaTotal()"></td>
                            <td class="p-3 text-center text-stone-400">1.00</td>
                            <td class="p-3 text-center font-bold text-stone-200 spa-row-amount">0.00</td>
                        </tr>
                        <tr class="hover:bg-[#221d18]">
                            <td class="p-3 font-semibold text-stone-300">BED SHEET</td>
                            <td class="p-3 text-center"><input type="number" class="spa-qty-input w-20 text-center remal-input rounded-lg p-1.5 font-bold" min="0" data-rate="2" oninput="calculateSpaTotal()"></td>
                            <td class="p-3 text-center text-stone-400">2.00</td>
                            <td class="p-3 text-center font-bold text-stone-200 spa-row-amount">0.00</td>
                        </tr>
                        <tr class="hover:bg-[#221d18]">
                            <td class="p-3 font-semibold text-stone-300">PILLOW CASE</td>
                            <td class="p-3 text-center"><input type="number" class="spa-qty-input w-20 text-center remal-input rounded-lg p-1.5 font-bold" min="0" data-rate="1" oninput="calculateSpaTotal()"></td>
                            <td class="p-3 text-center text-stone-400">1.00</td>
                            <td class="p-3 text-center font-bold text-stone-200 spa-row-amount">0.00</td>
                        </tr>
                        <tr class="hover:bg-[#221d18]">
                            <td class="p-3 font-semibold text-stone-300">BATHROBE</td>
